        },
        "description": "Test the mandatory GDPR shop data erasure webhook"
      },
      "response": []
    },
    {
      "name": "Test Invalid HMAC (Should Fail)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Override the collection pre-request script to set invalid HMAC",
              "pm.request.headers.add({",
              "    key: 'X-Shopify-Hmac-Sha256',",
              "    value: 'invalid_hmac_signature'",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Response status should be 401 or 403 for invalid HMAC', function () {",
              "    pm.expect([401, 403]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Shopify-Topic",
            "value": "customers/data_request"
          },
          {
            "key": "X-Shopify-Shop-Domain",
            "value": "{{test_shop_domain}}"
          },
          {
            "key": "X-Shopify-API-Version",
            "value": "2023-10"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"shop_id\": 12345678,\n  \"shop_domain\": \"{{test_shop_domain}}\",\n  \"customer\": {\n    \"id\": {{customer_id}},\n    \"email\": \"customer@example.com\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/webhooks/customers/data_request",
          "host": ["{{base_url}}"],
          "path": ["webhooks", "customers", "data_request"]
        },
        "description": "Test webhook with invalid HMAC signature to ensure validation is working"
      },
      "response": []
    }
  ]
}