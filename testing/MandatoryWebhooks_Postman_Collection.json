          "mode": "raw",
          "raw": "{\n  \"shop_id\": 12345678,\n  \"shop_domain\": \"{{test_shop_domain}}\",\n  \"customer\": {\n    \"id\": {{customer_id}},\n    \"email\": \"customer@example.com\",\n    \"phone\": \"+1234567890\"\n  },\n  \"orders_to_redact\": [\n    123456789,\n    987654321\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/webhooks/customers/redact",
          "host": ["{{base_url}}"],
