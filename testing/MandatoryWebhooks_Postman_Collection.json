{
  "info": {
    "name": "Shopify Mandatory Webhooks Testing",
    "description": "Complete testing collection for Shopify mandatory GDPR webhooks (customers/data_request, customers/redact, shop/redact)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://local.cinemargolpo.com",
      "type": "string",
      "description": "Your app's base URL"
    },
    {
      "key": "webhook_secret",
      "value": "7211d88235ad765be0a0bb7a4499bacc",
      "type": "string",
      "description": "Shopify webhook secret for HMAC signature (hardcoded from SHOPIFY_API_SECRET)"
    },
    {
      "key": "test_shop_domain",
      "value": "notify123.myshopify.com",
      "type": "string",
      "description": "Test shop domain"
    },
    {
      "key": "customer_id",
      "value": "12345678901234567",
      "type": "string",
      "description": "Test customer ID"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Shopify Webhook HMAC Generator",
          "// Hardcoded secret from SHOPIFY_API_SECRET: 7211d88235ad765be0a0bb7a4499bacc",
          "",
          "console.log('🚀 Generating HMAC for Shopify webhook...');",
          "",
          "// Hardcoded webhook secret (your SHOPIFY_API_SECRET)",
          "const webhookSecret = '7211d88235ad765be0a0bb7a4499bacc';",
          "",
          "// Get request body",
          "const requestBody = pm.request.body ? pm.request.body.raw : null;",
          "",
          "if (requestBody) {",
          "    try {",
          "        // Generate HMAC-SHA256 with Base64 encoding",
          "        const hmacSignature = CryptoJS.HmacSHA256(requestBody, webhookSecret).toString(CryptoJS.enc.Base64);",
          "        ",
          "        // Remove any existing X-Shopify-Hmac-Sha256 header",
          "        pm.request.headers.remove('X-Shopify-Hmac-Sha256');",
          "        ",
          "        // Add the HMAC header",
          "        pm.request.headers.add({",
          "            key: 'X-Shopify-Hmac-Sha256',",
          "            value: hmacSignature",
          "        });",
          "        ",
          "        console.log('✅ HMAC generated successfully!');",
          "        console.log('📝 Request body length:', requestBody.length, 'characters');",
          "        console.log('🔐 Generated HMAC:', hmacSignature);",
          "        console.log('🔑 Using secret:', webhookSecret.substring(0, 8) + '...(hardcoded)');",
          "        ",
          "    } catch (error) {",
          "        console.error('❌ HMAC generation failed:', error.message);",
          "        console.error('📋 Error details:', error);",
          "    }",
          "} else {",
          "    console.error('❌ No request body found!');",
          "    console.log('📋 Request body type:', typeof pm.request.body);",
          "    console.log('📋 Request body object:', pm.request.body);",
          "}",
          "",
          "console.log('🏁 HMAC generation process complete.');",
          "console.log('-------------------------------------------');"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "GDPR - Customer Data Request",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Response status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has success status', function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson.status).to.eql('success');",
              "});",
              "",
              "pm.test('Response contains message', function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson).to.have.property('message');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Shopify-Topic",
            "value": "customers/data_request"
          },
          {
            "key": "X-Shopify-Shop-Domain",
            "value": "{{test_shop_domain}}"
          },
          {
            "key": "X-Shopify-API-Version",
            "value": "2023-10"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"shop_id\": 12345678,\n  \"shop_domain\": \"{{test_shop_domain}}\",\n  \"orders_requested\": [\n    123456789\n  ],\n  \"customer\": {\n    \"id\": {{customer_id}},\n    \"email\": \"customer@example.com\",\n    \"phone\": \"+1234567890\"\n  },\n  \"data_request\": {\n    \"id\": 987654321\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/webhooks/customers/data_request",
          "host": ["{{base_url}}"],
          "path": ["webhooks", "customers", "data_request"]
        },
        "description": "Test the mandatory GDPR customer data request webhook"
      },
      "response": []
    },
