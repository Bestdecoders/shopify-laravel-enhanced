{
  "name": "@bestdecoders/shopify-laravel-enhanced",
  "version": "1.0.0",
  "description": "Frontend dependencies for Shopify Laravel Enhanced package - React components, Polaris integration, and enhanced UI features",
  "type": "module",
  "main": "resources/js/app.jsx",
  "repository": {
    "type": "git",
    "url": "https://github.com/bestdecoders/shopify-laravel-enhanced.git"
  },
  "keywords": [
    "shopify",
    "laravel",
    "react",
    "polaris",
    "size-charts",
    "faq",
    "documentation",
    "pricing",
    "shopify-app"
  ],
  "author": {
    "name": "Apurba Podder",
    "email": "seopage1it@gmail.com"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "@inertiajs/react": "^1.0.0",
    "@shopify/polaris": "^12.0.0",
    "@shopify/polaris-icons": "^8.0.0",
    "@shopify/app-bridge": "^4.0.0",
    "@shopify/app-bridge-react": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.3.0",
    "vite": "^5.0.0",
    "laravel-vite-plugin": "^1.0.0"
  },
  "optionalDependencies": {
    "lucide-react": "^0.292.0",
    "framer-motion": "^10.16.0",
    "react-hot-toast": "^2.4.0",
    "react-markdown": "^9.0.0",
    "react-syntax-highlighter": "^15.5.0",
    "fuse.js": "^7.0.0",
    "date-fns": "^2.30.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint resources/js --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint resources/js --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write resources/js/**/*.{js,jsx,ts,tsx}",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "resources/js/**/*",
    "resources/css/**/*",
    "resources/views/**/*",
    "dist/**/*",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/bestdecoders"
  }
}